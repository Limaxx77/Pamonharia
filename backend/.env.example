# ------------------------------------------------------------------
# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3333

# Use bancos SEPARADOS para demonstração e produção.
# Ex.: pamonharia_demo (dados fictícios) e pamonharia (operação real)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/pamonharia_demo?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# Origem(ns) do frontend (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# URL pública do sistema — é a base dos links gravados nos cartões NFC.
# Em produção use o domínio definitivo com HTTPS (ex.: https://pedidos.suapamonharia.com.br).
# Se mudar depois, os cartões precisarão ser regravados.
PUBLIC_APP_URL=http://localhost:5173

APP_TIMEZONE=America/Sao_Paulo

# Produção: true faz o backend servir o build do frontend (um único processo/porta)
SERVE_FRONTEND=false
# Produção com HTTPS: true
COOKIE_SECURE=false

UPLOAD_DIR=uploads
